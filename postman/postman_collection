  "item": [
    {
      "name": "1. Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response has pong message\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.eql(\"pong\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/blacklists/ping",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "blacklists",
            "ping"
          ]
        },
        "description": "Verifica que el servicio esté activo. No requiere autenticación."
      },
      "response": []
    },
    {
      "name": "2. Agregar Email a Blacklist (Éxito)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response contains success message\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.include(\"added to blacklist successfully\");",
              "    pm.expect(jsonData.email).to.eql(pm.variables.get("test_email"));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{bearer_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"app_uuid\": \"{{app_uuid}}\",\n  \"blocked_reason\": \"Actividad de spam detectada desde Postman\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/blacklists",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "blacklists"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. Consultar Email Blacklisteado (Éxito)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Email is marked as blacklisted\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.is_blacklisted).to.be.true;",
              "    pm.expect(jsonData.blocked_reason).to.eql(\"Actividad de spam detectada desde Postman\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{bearer_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/blacklists/{{test_email}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "blacklists",
            "{{test_email}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "4. Consultar Email NO Blacklisteado",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Email is NOT blacklisted\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.is_blacklisted).to.be.false;",
              "    pm.expect(jsonData.blocked_reason).to.be.null;",
              "});"
            ],
            "type": "text/javascript"
